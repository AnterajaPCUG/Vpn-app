#!/usr/bin/env sh

# Gradle start up script for POSIX generated by Gradle.

APP_HOME=$(pwd -P)
APP_BASE_NAME=${0##*/}

MAX_FD="maximum"

warn () {
    echo "$*"
}

die () {
    echo
    echo "$*"
    echo
    exit 1
}

EXECUTABLE="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
if [ ! -f "$EXECUTABLE" ]; then
    die "ERROR: Could not find gradle-wrapper.jar at '$EXECUTABLE'"
fi

CLASSPATH="$EXECUTABLE"

exec java $DEFAULT_JVM_OPTS $JAVA_OPTS -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
